int extended_gcd(int a, int b, int &x, int &y)
{
    x = 1;
    y = 0;
    int x1 = 0, y1 = 1, a1 = a, b1 = b;
    while (b1) {
        int q = a1 / b1;
        a1 %= b1;
        std::swap(a1, b1);
        x -= q * x1;
        std::swap(x, x1);
        y -= q * y1;
        std::swap(y, y1);
    }
    return a1;
}
